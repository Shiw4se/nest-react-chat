# Server Configuration
PORT=3000
FRONTEND_URL=http://localhost:5173

# Database
# Local server from `npm run db:start` (no sslmode needed):
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/chat"
# Hosted PostgreSQL (e.g. Neon) instead:
# DATABASE_URL="postgresql://user:password@host:port/dbname?sslmode=require"

# Where uploaded avatars are stored (default: ./uploads)
# UPLOADS_DIR=uploads

# Authentication
# Generate a random string for development
JWT_SECRET="your_super_secret_jwt_key_here"