# Server Configuration
PORT=3000
FRONTEND_URL=http://localhost:5173

# Database
# Local server from `npm run db:start` (no sslmode needed):
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/chat"
# Hosted PostgreSQL (e.g. Neon) instead:
# DATABASE_URL="postgresql://user:password@host:port/dbname?sslmode=require"

# File storage for avatars and chat images
#   local (default): files in UPLOADS_DIR (./uploads), served at /uploads
#   s3: any S3-compatible bucket (AWS S3, Cloudflare R2, MinIO). Use this on
#       hosts whose disk is wiped on deploy.
STORAGE_DRIVER=local
# UPLOADS_DIR=uploads
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=chat-uploads
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Authentication
# Generate a random string for development
JWT_SECRET="your_super_secret_jwt_key_here"