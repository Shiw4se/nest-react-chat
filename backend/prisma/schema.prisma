
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User{
  id String @id @default(uuid())
  username String @unique
  password String
  messages Message[]
  createdAt DateTime @default(now())
}

model Message {
  id String @id @default(uuid())
  room String
  message String
  createdAt DateTime @default(now())

  userId String
  user User @relation(fields: [userId], references: [id])
}